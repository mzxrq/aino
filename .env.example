# Example environment variables (DO NOT store real secrets here)
# Copy relevant values into your local `.env` files.

# -----------------------
# Backend (FastAPI / Python)
# -----------------------
# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/stock_anomaly_db
MONGO_DB_NAME=stock_anomaly_db


# JWT / Auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days in minutes


# LINE Login (OAuth) - backend only (sensitive)
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=
CHANNEL_ACCESS_TOKEN=""


# App / Server ports
NODE_ENV=development
EXPRESS_PORT=5050
FASTAPI_PORT=5000

# Market lists (backend may use these to schedule/fetch data)
MARKET_SYMBOLS={"US":["NVDA","AAPL","MSFT","GOOGL","AMZN","META","AVGO","TSLA","BRK.B","WMT","JPM","ORCL","LLY","V","JNJ","PG","HD","MA","UNH","XOM"],"JP":["7203.T","8306.T","6758.T","6501.T","7974.T","9983.T","9984.T","8316.T","6861.T","6098.T","8035.T","4519.T","7011.T","8001.T","8766.T","8058.T","9434.T","9433.T","8411.T","4063.T"],"TH":["DELTA.BK","PTT.BK","ADVANC.BK","GULF.BK","AOT.BK","KBANK.BK","SCB.BK","PTTEP.BK","TRUE.BK","IVL.BK","TIDLOR.BK","TU.BK","SCGP.BK","TOP.BK","HMPRO.BK","BBL.BK","CENTEL.BK","BGRIM.BK","BCPB.BK","TTW.BK"]}

# -----------------------
# Frontend (Vite + React)
# -----------------------
# Vite env variables must be prefixed with VITE_. These are safe to expose in dev builds
VITE_API_URL=http://localhost:5050        # Node/Express API (JS server)
VITE_LINE_PY_URL=http://localhost:5000    # Python FastAPI (LINE callback / profile)
VITE_LINE_REDIRECT_URI=http://localhost:5173/auth/callback

